  "baseCohortDefinition" : {
    "type" : "SQL",
    "name" : "Patient Cohort",
    "config" : {
      "sql" : "SELECT DISTINCT e.person_id AS client_id\nFROM mamba_z_encounter_obs e\n         JOIN mamba_fact_patients_latest_patient_demographics mdp\n              ON mdp.client_id = e.person_id\nWHERE\n    mdp.birthdate IS NOT NULL\n  AND mdp.gender IS NOT NULL\n  AND e.encounter_datetime BETWEEN :startDate AND :endDate\n    AND obs_question_uuid=\"\t0907d345-a413-41ec-a034-1e462622d62b\"\n  AND obs_answer_uuid=\"566e7e03-4024-4299-b12e-ecaa2820698d\";"
    }
  },
