{
  "name" : "ART Access Register",
  "description" : "Encounters imported from ART Access - Pharmacy dispensing data for ART patients",
  "category" : "FACILITY_REPORTS",
  "reportType" : "LINELIST",
  "limit" : 1000,
  "parameters" : [ {
    "name" : "startDate",
    "label" : "Start Date",
    "type" : "DATE",
