            "position": 9
          }
        },
        {
          "name": "VL Value",
          "key": "vl_value",
          "dataDefinition": {
            "type": "SQL",
            "config": {
              "sql": "SELECT CONCAT(COALESCE(vl.result_modifier, ''), ' ', vl.result_numeric) FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id = :episodeId AND native_order_id = :nativeOrderId  ORDER BY vl.sample_collection_date DESC LIMIT 1"
