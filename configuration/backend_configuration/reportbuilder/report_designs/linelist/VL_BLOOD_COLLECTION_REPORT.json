{
  "name": "Viral Blood Collection Report",
  "category": "FACILITY_REPORTS",
  "reportType": "LINELIST",
  "limit": 1000,
  "parameters": [
    {
      "name": "startDate",
      "label": "Start Date",
      "type": "DATE",
      "required": true
    },
    {
      "name": "endDate",
      "label": "End Date",
      "type": "DATE",
      "required": true
    }
  ],
  "baseCohortDefinition": {
    "type": "SQL",
    "name": "Patient Cohort",
    "config": {
      "sql": "SELECT DISTINCT vl.patient_id, episode_id,native_order_id\nFROM mamba_fact_viral_load_episode vl\nWHERE vl.accession_number IS NOT NULL AND vl.order_date BETWEEN :startDate AND :endDate",
      "filterMap": {
        "patientId": "vl.patient_id",
        "episodeId": "episode_id",
        "nativeOrderId": "native_order_id"
      }
    }
  },
  "dataSetDefinitions": [
    {
      "name": "PATIENT_LIST",
      "type": "PATIENT_DATA_SET",
      "rowFilter": {
        "type": "SQL",
        "name": "Patient Cohort",
        "config": {
          "sql": "SELECT DISTINCT vl.patient_id, episode_id,native_order_id\nFROM mamba_fact_viral_load_episode vl\nWHERE vl.accession_number IS NOT NULL AND vl.order_date BETWEEN :startDate AND :endDate",
          "filterMap": {
            "patientId": "vl.patient_id",
            "episodeId": "episode_id",
            "nativeOrderId": "native_order_id"
          }
        }
      },
      "columns": [
        {
          "name": "HIV Clinic No.",
          "key": "hiv_clinic_no",
          "dataDefinition": {
            "type": "IDENTIFIER",
            "config": {
              "identifierTypeUuid": "e1731641-30ab-102d-86b0-7a5022ba4115",
              "preferred": true
            }
          },
          "repeatResolution": {
            "strategy": "LATEST",
            "restrictToPeriod": false,
            "ignoreVoided": true
          },
          "_metadata": {
            "id": "col-0",
            "position": 0
          }
        },
        {
          "name": "Full Name",
          "key": "full_name",
          "dataDefinition": {
            "type": "PERSON_NAME",
            "config": {
              "type": "FULL_NAME",
              "preferred": true
            }
          },
          "_metadata": {
            "id": "col-1",
            "position": 1
          }
        },
        {
          "name": "Gender",
          "key": "gender",
          "dataDefinition": {
            "type": "PERSON_ATTRIBUTE",
            "config": {
              "type": "GENDER"
            }
          },
          "_metadata": {
            "id": "col-2",
            "position": 2
          }
        },
        {
          "name": "Age",
          "key": "age",
          "dataDefinition": {
            "type": "CALCULATION",
            "config": {
              "calculation": "AGE",
              "onDate": ":startDate"
            }
          },
          "_metadata": {
            "id": "col-3",
            "position": 3
          }
        },
        {
          "name": "Order Date",
          "key": "order_date",
          "dataDefinition": {
            "type": "SQL",
            "config": {
              "sql": "SELECT vl.order_date FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id= :episodeId AND native_order_id = :nativeOrderId  ORDER BY vl.order_date DESC LIMIT 1"
            }
          },
          "repeatResolution": {
            "strategy": "LATEST",
            "restrictToPeriod": false,
            "ignoreVoided": false
          },
          "_metadata": {
            "id": "col-4",
            "position": 4
          }
        },
        {
          "name": "Collection Date",
          "key": "collection_date",
          "dataDefinition": {
            "type": "SQL",
            "config": {
              "sql": "SELECT vl.sample_collection_date FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id= :episodeId AND native_order_id = :nativeOrderId  ORDER BY vl.sample_collection_date DESC LIMIT 1"
            }
          },
          "repeatResolution": {
            "strategy": "LATEST",
            "restrictToPeriod": false,
            "ignoreVoided": false
          },
          "_metadata": {
            "id": "col-5",
            "position": 5
          }
        },
        {
          "name": "Barcode (Sample Id)",
          "key": "barcode_sample_id",
          "dataDefinition": {
            "type": "SQL",
            "config": {
              "sql": "SELECT vl.accession_number FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id= :episodeId AND native_order_id = :nativeOrderId  ORDER BY vl.sample_collection_date DESC LIMIT 1"
            }
          },
          "repeatResolution": {
            "strategy": "LATEST",
            "restrictToPeriod": false,
            "ignoreVoided": false
          },
          "_metadata": {
            "id": "col-6",
            "position": 6
          }
        },
        {
          "name": "Status",
          "key": "status",
          "dataDefinition": {
            "type": "SQL",
            "config": {
              "sql": "SELECT CASE WHEN vl.result_status IS NOT NULL AND vl.result_status != 'PENDING' THEN 'Result Received' ELSE 'Pending' END FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id = :episodeId AND native_order_id = :nativeOrderId ORDER BY vl.sample_collection_date DESC LIMIT 1"
            }
          },
          "repeatResolution": {
            "strategy": "LATEST",
            "restrictToPeriod": false,
            "ignoreVoided": false
          },
          "_metadata": {
            "id": "col-7",
            "position": 7
          }
        },
