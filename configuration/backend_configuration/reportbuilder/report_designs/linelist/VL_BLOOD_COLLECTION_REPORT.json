              "sql": "SELECT vl.viral_load_clinical_date FROM mamba_fact_viral_load_episode vl WHERE vl.patient_id = :patientId AND episode_id = :episodeId AND native_order_id = :nativeOrderId  ORDER BY vl.sample_collection_date DESC LIMIT 1"
            }
