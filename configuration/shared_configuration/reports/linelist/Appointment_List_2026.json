        "type" : "SQL",
        "config" : {
          "sql" : "SELECT e.return_visit_date FROM mamba_fact_encounter_hiv_art_card e WHERE e.client_id = :patientId AND e.return_visit_date BETWEEN ':startDate' AND ':endDate' ORDER BY e.return_visit_date DESC LIMIT 1"
        }
      },
      "repeatResolution" : {
        "strategy" : "LATEST",
