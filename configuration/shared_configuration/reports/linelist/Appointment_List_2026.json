      "key" : "appointment_fulfillment",
      "dataDefinition" : {
        "type" : "SQL",
        "config" : {
          "sql" : "SELECT CASE WHEN e.return_visit_fulfilled = 1 THEN 'Yes' ELSE 'No' END FROM mamba_fact_encounter_hiv_art_card e WHERE e.client_id = :patientId AND e.return_visit_date BETWEEN :startDate AND :endDate AND e.voided = 0 ORDER BY e.return_visit_date DESC LIMIT 1"
