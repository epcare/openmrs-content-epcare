  "baseCohortDefinition" : {
    "type" : "SQL",
    "name" : "Indicator-based Patient Cohort",
    "config" : {
      "sql" : "SELECT DISTINCT a.client_id AS client_id FROM mamba_fact_encounter_hiv_art_card a\nJOIN mamba_fact_patients_latest_patient_demographics mdp\n  ON mdp.client_id = a.client_id\nWHERE\n  mdp.birthdate IS NOT NULL\n  AND mdp.gender IS NOT NULL\n  AND a.return_visit_date BETWEEN :startDate AND :endDate"
    }
  },
