  "baseCohortDefinition" : {
    "type" : "SQL",
    "name" : "ART Access Patients",
    "config" : {
      "sql" : "SELECT DISTINCT e.client_id AS client_id\nFROM mamba_fact_encounter_hiv_art_card e\nJOIN mamba_fact_patients_latest_patient_demographics mdp\n  ON mdp.client_id = e.client_id\nWHERE\n  mdp.birthdate IS NOT NULL\n  AND mdp.gender IS NOT NULL\n  AND e.encounter_date BETWEEN :startDate AND :endDate\n  AND e.voided = 0"
    }
  },
