    "name" : "Patient Cohort",
    "config" : {
      "sql" : "SELECT DISTINCT ct.client_id\nFROM mamba_fact_encounter_cacx_treatment ct\n         INNER JOIN mamba_fact_patients_latest_patient_demographics pd ON ct.client_id = pd.client_id\nWHERE pd.gender = 'F'\n  AND pd.dead = 0\n  AND pd.age BETWEEN :startAge AND :endAge\n  AND ct.encounter_date BETWEEN :startDate AND :endDate"
    }
  },
