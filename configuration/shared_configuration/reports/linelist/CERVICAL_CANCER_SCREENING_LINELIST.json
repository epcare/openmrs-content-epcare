    "name" : "Patient Cohort",
    "config" : {
      "sql" : "SELECT DISTINCT cs.client_id\nFROM mamba_fact_encounter_cacx_screening cs\n         inner join mamba_fact_patients_latest_patient_demographics pd on cs.client_id = pd.client_id\nwhere pd.gender = 'F'\n  AND pd.dead = 0\n  AND pd.age BETWEEN :startAge AND :endAge\n  AND cs.encounter_date BETWEEN :startDate AND :endDate\n"
    }
  },
