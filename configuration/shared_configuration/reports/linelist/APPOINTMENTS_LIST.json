        "restrictToPeriod" : false,
        "ignoreVoided" : true,
        "orderBy" : "obs_datetime"
      },
      "_metadata" : {
        "id" : "col-11",
        "position" : 11
      }
    }, {
      "name" : "VL Qualitative",
      "key" : "vl_qualitative",
      "dataDefinition" : {
        "type" : "SQL",
        "config" : {
          "sql" : "SELECT CASE WHEN (SELECT value_numeric FROM obs WHERE concept_id = 856 AND person_id = :patientId AND obs_datetime &lt;= :endDate AND voided = 0 ORDER BY obs_datetime DESC LIMIT 1) &lt; 1000 THEN 'Suppressed' ELSE 'Not Suppressed' END"
        }
