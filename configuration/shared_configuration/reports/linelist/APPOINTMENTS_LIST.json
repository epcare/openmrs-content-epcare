      "key" : "current_regimen",
      "dataDefinition" : {
        "type" : "SQL",
        "config" : {
          "sql" : "SELECT (SELECT cn.name\n        FROM concept_name cn\n        WHERE cn.concept_id = o.value_coded\n          AND cn.locale = 'en'\n          AND cn.concept_name_type = 'FULLY_SPECIFIED'\n          AND cn.voided = 0 LIMIT 1) as regimen\nFROM obs o\nWHERE o.concept_id = (SELECT concept_id\n                      FROM concept\n                      WHERE uuid IN ('dd2b0b4d-30ab-102d-86b0-7a5022ba4115'))\n  AND o.person_id = 1084\n  AND o.obs_datetime &lt;= :endDate\n  AND o.voided = 0\nORDER BY o.obs_datetime DESC\nLIMIT 1"
        }
      },
      "repeatResolution" : {
        "strategy" : "LATEST",
        "restrictToPeriod" : false,
        "ignoreVoided" : true,
        "orderBy" : "obs_datetime"
      },
