  "baseCohortDefinition" : {
    "type" : "SQL",
    "name" : "Patient Cohort",
    "config" : {
      "sql" : "SELECT DISTINCT o.person_id AS patient_id FROM obs o INNER JOIN encounter e ON o.encounter_id = e.encounter_id WHERE o.concept_id = 5096 AND o.value_datetime IS NOT NULL AND o.value_datetime &gt;= :startDate AND o.value_datetime &lt;= :endDate AND e.encounter_type IN (SELECT encounter_type_id FROM encounter_type WHERE uuid IN ('8d5b27bc-c2cc-11de-8d13-0010c6dffd0f', '8d5b2be0-c2cc-11de-8d13-0010c6dffd0f')) AND o.voided = 0 AND e.voided = 0"
    }
  },
