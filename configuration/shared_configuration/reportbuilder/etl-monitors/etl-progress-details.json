{"uuid":"a8b9c0d1-4e3f-4a2b-9d1c-2f9e8a7b6c5d","name":"ETL Progress Details","description":"Shows detailed step-by-step progress of the current ETL run","creator":"82f18b44-6814-11e8-923f-e9a88dcb533f","dateCreated":1786810095000,"changedBy":"82f18b44-6814-11e8-923f-e9a88dcb533f","dateChanged":1786810194000,"retired":false,"dateRetired":null,"retiredBy":null,"retireReason":null,"etlMonitorId":3,"code":"etl-progress-details","monitorType":"PROGRESS_BAR","configJson":"{\n  \"apiEndpoint\": {\n    \"url\": \"/ugandareportsetl?q=progress\",\n    \"method\": \"GET\",\n    \"authType\": \"OPENMRS\",\n    \"authConfig\": {\n      \"useSession\": \"true\"\n    }\n  }\n}","displayConfigJson":"{\n        \"columns\": [\n            {\n                \"key\": \"progress\",\n                \"header\": \"Overall Progress\",\n                \"jsonPath\": \"$.data.progressPercentage\",\n                \"columnType\": \"PROGRESS_BAR\",\n                \"colorMap\": {\n                    \"100\": \"green\",\n                    \"50\": \"blue\",\n                    \"25\": \"orange\"\n                },\n                \"defaultValue\": \"0\"\n            },\n            {\n                \"key\": \"current_step\",\n                \"header\": \"Current Stage\",\n                \"jsonPath\": \"$.data.currentStage\",\n                \"columnType\": \"TEXT\",\n                \"defaultValue\": \"Not started\"\n            },\n            {\n                \"key\": \"transaction_status\",\n                \"header\": \"Status\",\n                \"jsonPath\": \"$.data.transactionStatus\",\n                \"columnType\": \"STATUS_BADGE\",\n                \"colorMap\": {\n                    \"RUNNING\": \"blue\",\n                    \"COMPLETED\": \"green\",\n                    \"FAILED\": \"red\"\n                },\n                \"defaultValue\": \"Unknown\"\n            },\n            {\n                \"key\": \"start_time\",\n                \"header\": \"Start