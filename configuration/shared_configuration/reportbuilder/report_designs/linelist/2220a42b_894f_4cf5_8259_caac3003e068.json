  "baseCohortDefinition" : {
    "type" : "SQL",
    "name" : "Female patients with Maternity/PNC encounters between dates",
    "config" : {
      "sql" : "SELECT DISTINCT e.patient_id\nFROM encounter e\nINNER JOIN person p ON e.patient_id = p.person_id\nWHERE p.gender = 'F'\nAND e.encounter_type = (SELECT encounter_type_id FROM encounter_type WHERE uuid = '8d5b27bc-c2cc-11de-8d13-0010c6dffd0f')\nAND e.encounter_datetime BETWEEN :startDate AND :endDate\nAND e.voided = 0"
    }
  },
