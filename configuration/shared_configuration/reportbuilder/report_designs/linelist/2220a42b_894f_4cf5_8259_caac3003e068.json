      "name" : "PNC 1 (48hrs)",
      "key" : "pnc_1_done",
      "dataDefinition" : {
        "type" : "SQL",
        "config" : {
          "sql" : "SELECT CASE WHEN COUNT(*) > 0 THEN 'Yes' ELSE 'No' END FROM obs o INNER JOIN encounter e ON o.encounter_id = e.encounter_id INNER JOIN encounter_type et ON e.encounter_type = et.encounter_type_id WHERE o.person_id = :patientId AND et.uuid IN ('8d5b27bc-c2cc-11de-8d13-0010c6dffd0f', '8d5b2be0-c2cc-11de-8d13-0010c6dffd0f') AND o.concept_id IN (SELECT concept_id FROM concept_name WHERE name LIKE '%PNC%' AND locale = 'en') AND TIMESTAMPDIFF(HOUR, (SELECT value_datetime FROM obs WHERE person_id = :patientId AND concept_id = (SELECT concept_id FROM concept WHERE uuid = '5553AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA') ORDER BY obs_datetime DESC LIMIT 1), e.encounter_datetime) <= 48 AND e.voided = 0"
        }
      },
      "repeatResolution" : {
        "strategy" : "LATEST",
        "restrictToPeriod" : true,
        "ignoreVoided" : true
      }
    }, {
      "name" : "PNC 2 (6 days)",
      "key" : "pnc_2_done",
      "dataDefinition" : {
        "type" : "SQL",
        "config" : {
          "sql" : "SELECT CASE WHEN COUNT(*) > 0 THEN 'Yes' ELSE 'No' END FROM obs o INNER JOIN encounter e ON o.encounter_id = e.encounter_id INNER JOIN encounter_type et ON e.encounter_type = et.encounter_type_id WHERE o.person_id = :patientId AND et.uuid IN ('8d5b27bc-c2cc-11de-8d13-0010c6dffd0f', '8d5b2be0-c2cc-11de-8d13-0010c6dffd0f') AND o.concept_id IN (SELECT concept_id FROM concept_name WHERE name LIKE '%PNC%' AND locale = 'en') AND TIMESTAMPDIFF(DAY, (SELECT value_datetime FROM obs WHERE person_id = :patientId AND concept_id = (SELECT concept_id FROM concept WHERE uuid = '5553AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA') ORDER BY obs_datetime DESC LIMIT 1), e.encounter_datetime) BETWEEN 2 AND 6 AND e.voided = 0"
        }
